{
  "name": "dudebot-dispatch",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "triggers": {"crons": ["0,15,30,45 13-21 * * 1-5"]},
  "durable_objects": {"bindings": [{"name": "DISPATCH", "class_name": "NoonDispatch"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["NoonDispatch"]}]
}
